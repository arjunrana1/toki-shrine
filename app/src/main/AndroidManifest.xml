<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Normal, install-time permission for the turn-on/turn-off haptic
         confirmation (owner addendum, 13 September). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Runtime permission backing the fourth onboarding checklist row
         (PRD §12); only exists from API 33, which is the minSdk. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Special permission for the pause screen and timer bubble drawn over
         other apps (PRD §12). Without this declaration the app is absent
         from Settings › Special app access › Display over other apps, so
         the overlay row could never be granted (P3-F01, owner validation
         19 September). Granting stays user-mediated in that system screen;
         state is read only through Settings.canDrawOverlays. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Normal permission required to fire the universal
         ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS dialog (PRD §6 screen 4,
         the baseline battery path for non-Samsung manufacturers). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- The app picker lists launchable apps; this keeps package visibility
         scoped to launchable activities instead of QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".TokiApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TokiShrine">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phase 3 permission prerequisite: the declaration that makes the
             app grantable from system accessibility settings. The detection
             engine itself is Phase 4; this service observes nothing yet.
             Exported so the system can bind it; the signature-level
             BIND_ACCESSIBILITY_SERVICE permission keeps every other app out. -->
        <service
            android:name=".TokiAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

</manifest>
