<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Normal, install-time permission for the turn-on/turn-off haptic
         confirmation (owner addendum, 13 September). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Runtime permission backing the fourth onboarding checklist row
         (PRD §12); only exists from API 33, which is the minSdk. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Special permission for the pause screen and timer bubble drawn over
         other apps (PRD §12). Without this declaration the app is absent
         from Settings › Special app access › Display over other apps, so
         the overlay row could never be granted (P3-F01, owner validation
         19 September). Granting stays user-mediated in that system screen;
         state is read only through Settings.canDrawOverlays. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Normal permission required to fire the universal
         ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS dialog (PRD §6 screen 4,
         the baseline battery path for non-Samsung manufacturers). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Normal permissions backing the Phase 6 pause countdown service: it
         stays foreground while any block is paused so re-arm timing, the
         countdown notification and the bubble survive backgrounding. The
         declared type is specialUse (no standard type covers a blocking
         countdown); the subtype below states the purpose. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- The app picker lists launchable apps; this keeps package visibility
         scoped to launchable activities instead of QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".TokiApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TokiShrine">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phase 5 interruption and disable challenge host. Detection
             launches the block gate when a blocked target is in front;
             MainActivity launches the same unexported Activity for the
             stored-method turn-off challenge. Not exported:
             only Toki Shrine's own service starts it, and the
             accessibility background-launch exemption covers that start
             (PRD §13/§14), so no overlay permission is involved.
             Kept in its task while the process lives so ordinary app-switch
             and lock/unlock can resume the active challenge. -->
        <activity
            android:name=".BlockActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:label="@string/block_activity_label" />

        <!-- Permission prerequisite turned detection engine (Phase 4): the
             declaration that makes the app grantable from system
             accessibility settings, now implementing foreground-app
             detection and supported-browser address-bar reading.
             Exported so the system can bind it; the signature-level
             BIND_ACCESSIBILITY_SERVICE permission keeps every other app
             out. -->
        <service
            android:name=".TokiAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Phase 6 pause lifecycle host: started by the pause coordinator
             with the first pause, stops itself when the last pause ends
             (automatic re-arm). Owns the ongoing countdown notification
             (PRD §6 screen 21) and the overlay bubble (screen 20). Not
             exported: only Toki Shrine starts it. -->
        <service
            android:name=".pause.PauseService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the pause countdown, automatic re-arm and timer bubble alive while a block is paused." />
        </service>
    </application>

</manifest>
